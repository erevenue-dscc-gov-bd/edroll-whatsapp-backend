# ---- server ----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# CORS allowlist, comma-separated, e.g. https://hub.example.com,http://localhost:5500
# Leave blank to reflect the caller's origin (hosted previews, localhost, file:// demos).
FRONTEND_ORIGIN=

# ---- Meta WhatsApp Cloud API -----------------------------------------------
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
# Any random string; must match the token you type into the Meta app dashboard.
META_VERIFY_TOKEN=change-this-webhook-token
# App secret from the Meta app dashboard. When set, every webhook POST is
# signature-verified (X-Hub-Signature-256). Strongly recommended.
META_APP_SECRET=
# Outbound timeout for Graph API calls, in milliseconds.
GRAPH_TIMEOUT_MS=15000

# ---- storage ---------------------------------------------------------------
# Leave blank to use the embedded Postgres (PGlite) persisted to .data/pg.
# Set it for PostgreSQL/Supabase, e.g.
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# auto (default) | require | disable — SSL is auto-enabled for remote hosts.
DATABASE_SSL=
DATABASE_POOL_MAX=10
# Where the embedded database stores files (only used when DATABASE_URL is blank).
PGLITE_DIR=

# ---- behaviour -------------------------------------------------------------
# Reply automatically to every inbound message. Supports {{message}} and {{name}}.
# Leave blank to disable. Only run this with real credentials when you mean it.
AUTO_FORWARD_TEXT=
# Force Meta simulation on/off. Default: on when credentials are missing.
SIMULATE_META=
# Allow the simulator even when real credentials exist (useful for staging).
ENABLE_SIMULATOR=
