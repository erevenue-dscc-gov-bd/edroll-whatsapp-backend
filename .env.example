PORT=3000
HOST=0.0.0.0
# Leave blank to allow any origin (hosted preview, localhost, file:// demos).
# Set a comma-separated allowlist in production, e.g. https://hub.example.com
FRONTEND_ORIGIN=
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=change-this-webhook-token
META_APP_SECRET=
# Outbound timeout for Meta Graph API calls, in milliseconds.
GRAPH_TIMEOUT_MS=15000
